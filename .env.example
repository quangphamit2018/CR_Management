# ---------------------------------------------------------------------------
# Frontend (Vite) — các biến VITE_* được nhúng vào bundle trình duyệt.
# Anon/publishable key được Supabase thiết kế để công khai; bảo mật thật nằm ở
# Row Level Security. TUYỆT ĐỐI không đặt service_role key vào biến VITE_*.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://rnsjiqbbeywgbnqsojce.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Đặt true để BỎ QUA màn hình đăng nhập. Chỉ dùng khi bạn đã mở RLS cho role
# `anon`. Với cấu hình RLS mặc định (authenticated), để trống hoặc false.
VITE_ALLOW_ANON=false

# ---------------------------------------------------------------------------
# Chỉ dùng cho script scripts/sync-excel.mjs, chạy trên máy cá nhân.
# KHÔNG khai báo các biến dưới đây trong Vercel.
# ---------------------------------------------------------------------------

# Cách A — đăng nhập bằng tài khoản thường, chạy dưới quyền `authenticated`.
SYNC_EMAIL=
SYNC_PASSWORD=
# Cách B — service_role key, bỏ qua RLS. Nhanh hơn nhưng toàn quyền trên DB.
# Chỉ để trên máy cá nhân, không commit, không đưa lên Vercel.
SUPABASE_SERVICE_ROLE_KEY=
